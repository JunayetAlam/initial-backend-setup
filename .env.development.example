# Mode-specific env for `bun start:dev` (NODE_ENV=development).
# Copy to .env.development:  cp .env.development.example .env.development
# Loaded after .env and overrides overlapping keys (see src/config/index.ts).
#
# Local DATABASE_URL is built from PROJECT_SLUG, POSTGRES_* in .env.
# Set DATABASE_URL here only if you are not using Docker Compose.

NODE_ENV=development

SUPER_ADMIN_PASSWORD=123456
BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list allowed by CORS; the first entry is the primary client URL
BASE_URL_CLIENT="http://localhost:3000,http://localhost:3001"
BASE_URL_SERVER="http://localhost:5000"

# Plain HTTP, same host  -> COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# HTTPS, same site       -> COOKIE_SECURE=true,  COOKIE_SAMESITE=lax
# HTTPS, different sites -> COOKIE_SECURE=true,  COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional: share cookies across subdomains, e.g. ".example.com" (never an IP)
# COOKIE_DOMAIN=
