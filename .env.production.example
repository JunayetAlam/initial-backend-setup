# Mode-specific env for `bun start:prod` (NODE_ENV=production).
# Copy to .env.production:  cp .env.production.example .env.production
# Loaded after .env and overrides overlapping keys (see src/config/index.ts).

NODE_ENV=production

# Replace with your production Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

SUPER_ADMIN_PASSWORD=
BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list allowed by CORS; the first entry is the primary client URL
BASE_URL_CLIENT="https://example.com,https://admin.example.com"
BASE_URL_SERVER="https://api.example.com"

# Plain HTTP, same host  -> COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# HTTPS, same site       -> COOKIE_SECURE=true,  COOKIE_SAMESITE=lax
# HTTPS, different sites -> COOKIE_SECURE=true,  COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Optional: share cookies across subdomains, e.g. ".example.com" (never an IP)
# COOKIE_DOMAIN=
