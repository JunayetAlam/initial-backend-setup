model User {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  email       String       @unique
  phoneNumber String?      @unique
  password    String?
  role        UserRoleEnum @default(USER)

  status UserStatus @default(ACTIVE)

  bio      String?
  location String?

  isAgreeWithTerms Boolean
  profilePhoto     String?

  otp       String?
  otpFor    OTPFor?
  otpExpiry DateTime?
  otpAttempts Int @default(0)

  passwordResetToken        String?
  passwordResetTokenExpires DateTime?

  isDeleted                     Boolean   @default(false)
  isEmailVerified               Boolean   @default(false)
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?

  loginWay LoginWay? @default(EMAIL)

  firebaseUid      String?
  firebaseProvider FirebaseProvider?

  sessions        Session[]
  uploadedFiles   UploadedFile[]   @relation("FileUploadedBy")
  uploadedFolders UploadedFolder[] @relation("FolderCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum OTPFor {
  USER_VERIFICATION
  FORGOT_PASSWORD
  NOT
}

enum UserRoleEnum {
  USER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LoginWay {
  EMAIL
  FIREBASE
}

enum FirebaseProvider {
  GOOGLE
  FACEBOOK
}
